# 이 파일을 .env로 복사해서 쓴다. .env는 절대 커밋하지 않는다.

# LLM 제공자: mock(기본, 비용 0) | openai | anthropic
# 개발·테스트·CI는 mock으로 둔다. 실측 진단 실행에서만 실제 API를 쓴다 (설계서 v2 §1.5).
LLM_PROVIDER=mock

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 챗봇 모드: vulnerable | defended
CHATBOT_MODE=vulnerable

# 데이터셋 경로 (이유진 데이터셋이 들어오기 전에는 테스트 픽스처를 써도 됨)
DATASET_PATH=datasets/insurance

TARGET_CHATBOT_URL=http://localhost:8000
DIAG_ENGINE_URL=http://localhost:8100
